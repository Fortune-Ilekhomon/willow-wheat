# Database
DATABASE_URL="postgresql://user:password@localhost:5432/willow_wheat_dev"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=""

# Admin seed (used only by prisma/seed.ts to create the first owner account)
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="Bakery Owner"

# Cloudflare R2 (product images, custom order inspiration images)
# Account ID and API token come from an R2 API Token created in the
# Cloudflare dashboard, scoped to R2_BUCKET_NAME only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public URL the bucket serves from — either the r2.dev development URL or
# a connected custom domain. Used to build the URL stored on Product.images
# after a successful upload; never used for authentication.
R2_PUBLIC_URL=""
